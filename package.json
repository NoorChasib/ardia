{
  "name": "ardia",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24",
    "bun": ">=1.4.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "!apps/site",
    "!apps/dashboard",
    "!apps/videos",
    "!apps/phone",
    "!packages/phone"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@ardia/browser",
    "macos": "pnpm --filter @ardia/browser macos",
    "pods": "pnpm --filter @ardia/browser pods",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "shaders:check": "turbo run shaders:check",
    "test": "turbo run test && bun run test:root",
    "test:root": "bun test --timeout=0 --tsconfig-override=./scripts/lib/test-tsconfig.json ./extras/raycast-ardia/src/scripts.test.ts ./scripts ./apps/site/src",
    "test:vouch": "bun test --timeout=0 ./.github/vouch/vouch.test.cjs",
    "test:linux-smoke": "bun test --timeout=0 ./scripts/linux/smoke.test.mjs",
    "test:linux-ubo-seed": "bun test --timeout=0 ./scripts/linux/ubo-seed.test.mjs",
    "test:engine-linux": "node --test engine/ardiacore-linux/tests/bootstrap.test.mjs",
    "test:portable": "bun run test:portable:packages && bun run test:portable:mac && bun run test:root",
    "test:portable:mac": "turbo run test:portable",
    "test:portable:packages": "turbo run test --filter=!@ardia/ardiacore --filter=!@ardia/import --filter=!@ardia/shell --filter=!@ardia/sync"
  },
  "devDependencies": {
    "@typescript/typescript6": "~6.0.2",
    "turbo": "^2.11.3",
    "typescript": "~7.0.2"
  },
  "patchedDependencies": {
    "expo-constants@18.0.14": "patches/expo-constants@18.0.14.patch",
    "expo-modules-core@3.0.30": "patches/expo-modules-core@3.0.30.patch",
    "react-native-macos@0.81.9": "patches/react-native-macos@0.81.9.patch",
    "react-native-web@0.21.4": "patches/react-native-web@0.21.4.patch"
  },
  "trustedDependencies": [],
  "license": "SEE LICENSE IN NOTICE"
}
