<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="search"
        android:enabled="true"
        android:icon="@drawable/shortcut_search"
        android:shortcutShortLabel="@string/shortcut_search"
        android:shortcutLongLabel="@string/shortcut_search">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="nilla://search"
            android:targetClass="com.ardia.browser.android.system.ShortcutActivity"
            android:targetPackage="com.nilladigital.nilla.android">
            <extra
                android:name="com.ardia.SOURCE"
                android:value="shortcut" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="voice"
        android:enabled="true"
        android:icon="@drawable/shortcut_voice"
        android:shortcutShortLabel="@string/shortcut_voice_search"
        android:shortcutLongLabel="@string/shortcut_voice_search">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="nilla://voice"
            android:targetClass="com.ardia.browser.android.system.ShortcutActivity"
            android:targetPackage="com.nilladigital.nilla.android">
            <extra
                android:name="com.ardia.SOURCE"
                android:value="shortcut" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="incognito"
        android:enabled="true"
        android:icon="@drawable/shortcut_incognito"
        android:shortcutShortLabel="@string/shortcut_incognito_short"
        android:shortcutLongLabel="@string/shortcut_incognito">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="nilla://incognito"
            android:targetClass="com.ardia.browser.android.system.ShortcutActivity"
            android:targetPackage="com.nilladigital.nilla.android">
            <extra
                android:name="com.ardia.SOURCE"
                android:value="shortcut" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="mac-tabs"
        android:enabled="@bool/ardia_sync_offered"
        android:icon="@drawable/shortcut_mac_tabs"
        android:shortcutShortLabel="@string/shortcut_mac_tabs_short"
        android:shortcutLongLabel="@string/shortcut_mac_tabs">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="nilla://mac-tabs"
            android:targetClass="com.ardia.browser.android.system.ShortcutActivity"
            android:targetPackage="com.nilladigital.nilla.android">
            <extra
                android:name="com.ardia.SOURCE"
                android:value="shortcut" />
        </intent>
    </shortcut>
</shortcuts>
