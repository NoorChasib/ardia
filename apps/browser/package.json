{
  "name": "@ardia/browser",
  "version": "0.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "react-native start",
    "macos": "xcodebuild -workspace macos/Ardia.xcworkspace -scheme Ardia-macOS -derivedDataPath build -destination 'platform=macOS,arch=arm64' -quiet -configuration Debug && open -n --env ARDIA_DATA_DIR=\"${ARDIA_DATA_DIR:-$HOME/Library/Application Support/Ardia Dev}\" build/Build/Products/Debug/Ardia.app",
    "pods": "cd macos && pod install",
    "build": "xcodebuild -workspace macos/Ardia.xcworkspace -scheme Ardia-macOS -derivedDataPath build -destination 'platform=macOS,arch=arm64' -quiet -configuration Release",
    "check": "tsc -p .",
    "test": "bun ../../scripts/lib/bun-tests.mjs --node-only=node-tests.json --default=./src --default=./scripts --parallel --timeout=0 --tsconfig-override=../../scripts/lib/test-tsconfig.json --preload ./src/test-preload.mjs",
    "bundle:windows": "react-native bundle --platform windows --dev false --entry-file index.js --bundle-output build-windows/index.windows.bundle --assets-dest build-windows"
  },
  "dependencies": {
    "@ardia/core": "workspace:*",
    "@ardia/shaders": "workspace:*",
    "@ardia/shell": "workspace:*",
    "@ardia/ardiacore": "workspace:*",
    "@ardia/import": "workspace:*",
    "@ardia/sync": "workspace:*",
    "expo": "~54.0.37",
    "expo-modules-core": "~3.0.29",
    "react": "19.1.4",
    "react-native": "0.81.6",
    "react-native-macos": "0.81.9",
    "zustand": "^5.0.8",
    "react-native-windows": "0.81.38"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native-community/cli": "^20.0.0",
    "@react-native-community/cli-platform-apple": "^20.0.0",
    "@react-native-community/cli-platform-ios": "^20.0.0",
    "@react-native/babel-preset": "0.81.6",
    "@react-native/metro-config": "0.81.6",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.0",
    "react-dom": "19.1.4",
    "typescript": "~7.0.2"
  }
}
