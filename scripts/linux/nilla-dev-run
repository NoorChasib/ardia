#!/usr/bin/env bash
# usage: scripts/linux/nilla-dev-run <extracted build folder> [browser arguments...]
#
# Starts an extracted Linux build of Nilla with ARDIA_DATA_DIR and ARDIA_CONFIG_HOME, which must both be set to a
# scratch or Nilla-only folder, with --user-data-dir=$ARDIA_CONFIG_HOME/ardia (so the UI knows the profile is its own)
# and --password-store=basic, so today's engine never reaches an installed Ardia's profile, data or secret-store items.
# The engine writes the nilla-browser rendezvous file (ArdiaControl.json) into that profile, where nilla-browser looks
# when ARDIA_CONFIG_HOME is set. It refuses --user-data-dir and --password-store among the browser arguments. It never
# installs anything. It is not a sandbox: it runs only where the filesystem is verified to be isolated (a user and mount
# namespace with a scratch HOME, in which no account's home folder, nor the folder that would hold Ardia's config,
# data, cache or state folders in it, is writable, as tools/isolate gives), or with NILLA_DISPOSABLE_HOST=1 on a
# throwaway VM, container or CI runner. Either way it refuses a machine where Ardia's folders exist in HOME or in any
# account's home.
set -euo pipefail

usage() { sed -n '2,13s/^# \{0,1\}//p' "$0"; }
die() { echo "nilla-dev-run: $*" >&2; exit 2; }

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  "") usage >&2; exit 2 ;;
esac
build="$1"
shift
launcher="$build/bin/ardia"
[ -x "$launcher" ] || die "$build has no bin/ardia; pass the folder the build's tarball extracted to"

resolved() { realpath -m -- "$1"; }

ardia_subfolders=(.config/ardia .local/share/ardia .cache/ardia .local/state/ardia)

account_homes() {
  {
    getent passwd || true
    getent passwd "$(id -u)" || true
    local inside outside count
    while read -r inside outside count; do getent passwd "$outside" || true; done < /proc/self/uid_map
  } | cut -d: -f6 | awk 'NF && !seen[$0]++'
}

mapfile -t homes < <(account_homes)
ardia_folders=("${XDG_CONFIG_HOME:-$HOME/.config}/ardia" "${XDG_DATA_HOME:-$HOME/.local/share}/ardia" "${XDG_CACHE_HOME:-$HOME/.cache}/ardia" "${XDG_STATE_HOME:-$HOME/.local/state}/ardia")
for home in "$HOME" "${homes[@]}"; do
  for subfolder in "${ardia_subfolders[@]}"; do ardia_folders+=("$home/$subfolder"); done
done

in_user_namespace() {
  local map
  map="$(cat /proc/self/uid_map 2>/dev/null)" || return 1
  read -r -a map <<< "$map"
  [ "${map[*]}" != "0 0 4294967295" ]
}

nearest_existing() {
  local path="$1"
  while [ ! -e "$path" ] && [ ! -L "$path" ] && [ "$path" != / ]; do path="$(dirname -- "$path")"; done
  printf '%s\n' "$path"
}

not_isolated=""
filesystem_isolated() {
  in_user_namespace || { not_isolated="this isn't a user namespace"; return 1; }
  local scratch_home home target subfolder
  scratch_home="$(resolved "$HOME")"
  for home in "${homes[@]}"; do
    [ -d "$home" ] || continue
    [ "$(resolved "$home")" != "$scratch_home" ] || { not_isolated="HOME=$HOME is the account folder $home, not a scratch HOME"; return 1; }
    for subfolder in "" "${ardia_subfolders[@]}"; do
      target="$(nearest_existing "${home}${subfolder:+/$subfolder}")"
      if [ -w "$target" ]; then not_isolated="$target is writable here, so the build could reach $home"; return 1; fi
    done
  done
}

if [ "${NILLA_DISPOSABLE_HOST:-}" != 1 ] && ! filesystem_isolated; then
  die "the filesystem isn't verified to be isolated ($not_isolated). Run it inside tools/isolate, or a user and mount namespace that gives a scratch HOME and covers every account's home read-only, or set NILLA_DISPOSABLE_HOST=1 on a throwaway VM, container or CI runner; never on an account that has or may get Ardia"
fi
for folder in "${ardia_folders[@]}"; do
  if [ -e "$folder" ] || [ -L "$folder" ]; then
    die "this machine has Ardia's $folder; run Nilla's development build only where Ardia has never run"
  fi
done

touches_ardia() {
  local path folder
  path="$(resolved "$1")"
  for folder in "${ardia_folders[@]}"; do
    folder="$(resolved "$folder")"
    [[ "$path" == "$folder" || "$path" == "$folder"/* ]] && return 0
  done
  return 1
}

for variable in ARDIA_DATA_DIR ARDIA_CONFIG_HOME; do
  value="${!variable:-}"
  [ -n "$value" ] || die "set $variable to a scratch or Nilla-only folder; this development build never uses Ardia's"
  [[ "$value" == /* ]] || die "$variable must be an absolute path, not $value"
  [ "$(resolved "$value")" != "$(resolved "$HOME")" ] || die "$variable can't be your home folder"
  touches_ardia "$value" && die "$variable=$value is inside Ardia's folders"
done
touches_ardia "$ARDIA_CONFIG_HOME/ardia" && die "ARDIA_CONFIG_HOME=$ARDIA_CONFIG_HOME would put the profile in Ardia's folder $ARDIA_CONFIG_HOME/ardia"
profile="$(resolved "$ARDIA_CONFIG_HOME/ardia")"
[[ "$profile" == "$(resolved "$ARDIA_CONFIG_HOME")"/* ]] || die "the profile $profile isn't inside ARDIA_CONFIG_HOME=$ARDIA_CONFIG_HOME"
[ ! -L "$ARDIA_CONFIG_HOME/ardia" ] || die "$ARDIA_CONFIG_HOME/ardia is a link; the profile must be a real folder of its own"

for argument in "$@"; do
  [[ "$argument" =~ ^--?(user-data-dir|password-store)(=|$) ]] && die "$argument isn't allowed: the profile comes from ARDIA_CONFIG_HOME and the password store is always basic"
done

mkdir -p -- "$ARDIA_DATA_DIR" "$ARDIA_CONFIG_HOME"
export ARDIA_DATA_DIR ARDIA_CONFIG_HOME
exec "$launcher" "--user-data-dir=$profile" --password-store=basic "$@"
