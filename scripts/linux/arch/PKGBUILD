pkgname=ardia-bin
pkgver=0.0.0
pkgrel=1
pkgdesc="Nilla, a Chromium-based browser with Arc's sidebar and Dia's polish, based on Ardia"
arch=('x86_64')
url="https://github.com/NoorChasib/nilla"
license=('GPL-3.0-only' 'Apache-2.0')
depends=('alsa-lib' 'dbus' 'gtk3' 'hicolor-icon-theme' 'libcups' 'libxss' 'libxtst' 'nss' 'polkit' 'ttf-liberation' 'xdg-utils')
optdepends=(
  'libsecret: encrypt saved passwords with the Secret Service keyring'
  'kwallet: encrypt saved passwords with KWallet'
  'polkit-gnome: a polkit agent to confirm it is you before secrets are shown'
)
provides=('ardia')
conflicts=('ardia')
options=('!strip' '!debug')
source=("ardia-linux-x64.tar.xz")
sha256sums=('SKIP')

pkgver() {
  local version
  version=$(cat "$srcdir/ardia/lib/ardia/VERSION" 2>/dev/null) || version=$pkgver
  printf '%s\n' "${version//-/_}"
}

package() {
  "$srcdir/ardia/install.sh" --prefix /usr --destdir "$pkgdir"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" "$srcdir/ardia/lib/ardia/licenses/"*
}
