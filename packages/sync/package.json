{
  "name": "@nilla/sync",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end-encrypted sync through a folder the user chooses (iCloud Drive, Dropbox, a NAS, a USB drive)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "type": "module",
  "scripts": {
    "check": "tsc -p .",
    "test:portable": "node ../../apps/phone/scripts/bundle-shared.mjs --check && bun test --parallel --timeout=0 --tsconfig-override=../../scripts/lib/test-tsconfig.json ./src",
    "test": "swift test --scratch-path \"${TMPDIR:-/tmp}/nilla-sync-swiftpm\" && bun run test:portable"
  },
  "peerDependencies": {
    "expo": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/node": "^24.13.6"
  }
}
